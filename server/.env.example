# Server Environment Variables
# Copy this file to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# Use these values when deployed (Netlify frontend → Render backend):
# NODE_ENV=production
# CLIENT_URL=https://om-cellular.netlify.app

# MongoDB
MONGODB_URI=mongodb://localhost:27017/omcellular

# JWT (generate strong random strings for production)
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload directory (relative to server root)
UPLOAD_DIR=uploads
