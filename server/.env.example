# Server Environment Variables
# Copy this file to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# Use these values when deployed (Netlify frontend → Render backend):
# NODE_ENV=production
# CLIENT_URL=https://om-cellular.vercel.app/

# MongoDB
MONGODB_URI=mongodb://localhost:27017/omcellular

# Admin account (used by `npm run seed:admin` to create/ensure the admin@gmail.com
# account). The password passed here is hashed with bcrypt before storage — never
# stored or logged as plaintext. Set a strong value in production.
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# JWT (generate strong random strings for production)
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload directory (relative to server root)
UPLOAD_DIR=uploads

# Razorpay (required to activate UPI / Net Banking online payments)
# Get these from https://dashboard.razorpay.com/app/keys
# Online payment options only appear in checkout when BOTH key id and secret are set.
# Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret (configure the webhook URL -> https://om-cellular.onrender.com/api/v1/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=
